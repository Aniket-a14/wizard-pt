# ---------- App ----------
NEXT_PUBLIC_APP_NAME="Wizard PT"

# ---------- Supabase (Project Settings → API) ----------
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Server-only. Never expose to the browser. Used for grading, answer-key release, bootstrap.
SUPABASE_SECRET_KEY=sb_secret_...
# Only needed for `pnpm db:push` / scripts that talk to Postgres directly.
SUPABASE_DB_URL=postgresql://postgres:...@db.YOUR-PROJECT.supabase.co:5432/postgres

# ---------- Code execution ----------
# "judge0" (production), "docker" (local / self-hosted single machine only) or
# "manual" (external-runner mode: students run code elsewhere and submit for review; grade with `pnpm grade`)
RUNNER_PROVIDER=judge0
RUNNER_MAX_CONCURRENCY=2

# Judge0 — pick ONE of the two hosting styles below
JUDGE0_URL=https://judge0-ce.p.rapidapi.com
# Hosted on RapidAPI:
JUDGE0_RAPIDAPI_KEY=
JUDGE0_RAPIDAPI_HOST=judge0-ce.p.rapidapi.com
# Self-hosted (set AUTHN_TOKEN in judge0.conf and put it here):
JUDGE0_AUTH_TOKEN=
# Java language id: 62 = OpenJDK 13 on Judge0 CE 1.13.x. GET /languages on your instance to confirm.
JUDGE0_JAVA_LANGUAGE_ID=62
JUDGE0_CPP_LANGUAGE_ID=54
JUDGE0_C_LANGUAGE_ID=50
JUDGE0_MAX_MEMORY_KB=512000
JUDGE0_POLL_TIMEOUT_MS=60000

# Docker runner only
RUNNER_DOCKER_IMAGE=eclipse-temurin:21-jdk
RUNNER_DOCKER_GCC_IMAGE=gcc:14
# RUNNER_ALLOW_DOCKER=1   # required to use the docker runner when NODE_ENV=production

# ---------- Bootstrap (read by `pnpm bootstrap`; keep out of git, delete after use) ----------
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Admin
STUDENT_EMAIL=
STUDENT_PASSWORD=
STUDENT_NAME=Student
