{
  "name": "wizard-pt",
  "version": "0.1.0",
  "description": "Private coding and MCQ practice platform: an admin publishes Java problems and quizzes, a student solves them in a LeetCode-style workspace, and the admin reviews the results.",
  "author": "Aniket Saha <aniketsahaworkspace@gmail.com>",
  "license": "UNLICENSED",
  "homepage": "https://wizard-pt.vercel.app",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Aniket-a14/wizard-pt.git"
  },
  "bugs": {
    "url": "https://github.com/Aniket-a14/wizard-pt/issues"
  },
  "keywords": [
    "nextjs",
    "supabase",
    "java",
    "judge0",
    "mcq",
    "quiz",
    "coding-practice",
    "education"
  ],
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run src",
    "test:e2e": "playwright test",
    "bootstrap": "tsx scripts/bootstrap-users.ts",
    "seed": "tsx scripts/seed.ts",
    "seed:remove": "tsx scripts/seed.ts --remove",
    "grade": "tsx --conditions=react-server scripts/grade-pending.ts",
    "problem:add": "tsx scripts/add-problem.ts",
    "db:start": "supabase start -x imgproxy,vector,logflare,edge-runtime,studio",
    "db:reset": "supabase db reset",
    "db:push": "supabase db push",
    "db:types": "supabase gen types typescript --local > src/lib/supabase/database.types.ts"
  },
  "dependencies": {
    "@monaco-editor/react": "^4.7.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.118.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "katex": "^0.19.0",
    "lucide-react": "^1.61.0",
    "next": "16.4.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "^10.1.0",
    "react-resizable-panels": "^4.14.8",
    "rehype-katex": "^7.0.1",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "server-only": "^0.0.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "unpdf": "^1.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^5.0.5",
    "dotenv": "^18.0.8",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "supabase": "^2.121.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.5"
  },
  "packageManager": "pnpm@12.5.1",
  "engines": {
    "node": ">=20"
  }
}
